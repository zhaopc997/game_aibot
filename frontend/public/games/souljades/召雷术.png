<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" width="100%" height="100%">
  <defs>
    <radialGradient id="jbg" cx="50%" cy="45%" r="65%">
      <stop offset="0%" stop-color="#4f46e5" stop-opacity="0.9" />
      <stop offset="60%" stop-color="#312e81" stop-opacity="1" />
      <stop offset="100%" stop-color="#050507" stop-opacity="1" />
    </radialGradient>
    <radialGradient id="jadeCore" cx="45%" cy="40%" r="55%">
      <stop offset="0%" stop-color="#ffffff" stop-opacity="0.4" />
      <stop offset="40%" stop-color="#c7d2fe" stop-opacity="0.85" />
      <stop offset="100%" stop-color="#312e81" stop-opacity="0.95" />
    </radialGradient>
    <linearGradient id="jgold" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#fef9c3" />
      <stop offset="50%" stop-color="#facc15" />
      <stop offset="100%" stop-color="#a16207" />
    </linearGradient>
    <filter id="jshadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="4" stdDeviation="6" flood-color="#000000" flood-opacity="0.8" />
    </filter>
  </defs>

  <!-- Background -->
  <rect width="256" height="256" rx="44" fill="url(#jbg)" />
  <rect width="250" height="250" x="3" y="3" rx="41" fill="none" stroke="url(#jgold)" stroke-width="2" opacity="0.5" />

  <!-- Jade Medallion Outer Filigree Ring -->
  <circle cx="128" cy="112" r="68" fill="none" stroke="url(#jgold)" stroke-width="4" filter="url(#jshadow)" />
  <circle cx="128" cy="112" r="62" fill="none" stroke="#c7d2fe" stroke-width="1.5" stroke-dasharray="5 3" opacity="0.6" />
  
  <!-- Glowing Jade Inner Disc -->
  <circle cx="128" cy="112" r="56" fill="url(#jadeCore)" stroke="url(#jgold)" stroke-width="2" />
  <circle cx="128" cy="112" r="22" fill="#000000" fill-opacity="0.35" stroke="url(#jgold)" stroke-width="1" />

  <!-- Center Ancient Sigil Glyph -->
  <text x="128" y="126" font-family="'PingFang SC', 'Noto Serif SC', 'Kaiti SC', serif" font-weight="900" font-size="40" fill="#ffffff" text-anchor="middle" filter="url(#jshadow)">雷</text>

  <!-- Top Badge -->
  <g transform="translate(128, 32)">
    <rect x="-48" y="-11" width="96" height="19" rx="9" fill="#000000" fill-opacity="0.75" stroke="#c7d2fe" stroke-width="1" />
    <text x="0" y="2.5" font-family="'PingFang SC', sans-serif" font-weight="bold" font-size="9.5" fill="#c7d2fe" text-anchor="middle">天地绝技神玉</text>
  </g>

  <!-- Bottom Name Banner -->
  <g transform="translate(128, 218)">
    <rect x="-65" y="-18" width="130" height="28" rx="8" fill="#09090b" fill-opacity="0.9" stroke="url(#jgold)" stroke-width="1.2" />
    <text x="0" y="-3" font-family="'PingFang SC', sans-serif" font-weight="bold" font-size="12" fill="#fef08a" text-anchor="middle">召雷术</text>
    <text x="0" y="8" font-family="sans-serif" font-weight="500" font-size="8" fill="#a1a1aa" text-anchor="middle">Thunder Call</text>
  </g>
</svg>