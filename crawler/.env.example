# 数据库(复用后端 docker-compose)
PG_HOST=localhost
PG_PORT=5432
PG_DB=guide_platform
PG_USER=postgres
PG_PASSWORD=postgres

# 采集者用户 ID(由 make_seed_user.py 创建,默认 = 1)
CRAWLER_AUTHOR_ID=1

# 抓取策略
ROBOTSTXT_OBEY=true       # 默认遵从 robots.txt;仅在有明确理由时设为 false
DOWNLOAD_DELAY=1.0          # 每请求间隔(秒)
CONCURRENT_REQUESTS=1       # 全局并发
MAX_ITEMS_PER_RUN=200       # 单次运行最多抓取条数(限速与合规保护)
PLAYWRIGHT_TIMEOUT=30       # 页面加载超时(秒)
