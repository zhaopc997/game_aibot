# ═══════════════════════════════════════════════════════════════
# 告警渠道配置
#
#   复制为 .alert.env 后填写，并 chmod 600（含 webhook 密钥）
#     cp .alert.env.example .alert.env && chmod 600 .alert.env
#
#   三个渠道可以都填（同时发送），也可以只填一个。
#   一个都不填时，health-check.sh 只在日志里留痕、不发通知。
# ═══════════════════════════════════════════════════════════════

# ───── 企业微信群机器人（推荐，最省事）─────
# 群聊右上角 → 群机器人 → 添加机器人 → 复制 Webhook 地址
WECOM_WEBHOOK=

# ───── 钉钉群机器人 ─────
# 群设置 → 智能群助手 → 添加机器人 → 自定义 → 复制 Webhook
# 注意：若机器人安全设置选了「加签」，本脚本不支持加签，请改用
#       「自定义关键词」方式（关键词填 helozero 或 巡检）
DINGTALK_WEBHOOK=

# ───── 通用 Webhook ─────
# POST JSON: {"title","content","level","host","time"}
# 可用于 Server酱中转、PushDeer、自建接收端等
ALERT_WEBHOOK=
