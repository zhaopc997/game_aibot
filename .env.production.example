# ═══════════════════════════════════════════════════════════════
# 生产环境变量模板
#
# 使用：
#   cp .env.production.example .env.production
#   # 填入真实值（密钥类必须改）
#   chmod 600 .env.production          # 仅所有者可读
#   docker compose -p gameaibot -f docker-compose.prod.yml --env-file .env.production up -d --build
#
# .env.production 含真实密钥，务必不要提交到 Git（已加入 .gitignore）
# ═══════════════════════════════════════════════════════════════

# ───── 端口 ─────
# 生产统一入口端口（Nginx），后端/数据库等不对外暴露
HTTP_PORT=80

# ───── PostgreSQL ─────
DB_NAME=guide_platform
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME

# ───── Redis ─────
REDIS_PASSWORD=CHANGE_ME
REDIS_MAXMEMORY=512mb

# ───── Elasticsearch ─────
# 单节点内网部署可保持 false；若暴露到公网必须置 true 并配 ES_PASSWORD
ES_SECURITY_ENABLED=false
ES_PASSWORD=
ES_HEAP=1g

# ───── MinIO ─────
MINIO_USER=CHANGE_ME
MINIO_PASSWORD=CHANGE_ME

# ───── JWT（必填）─────
# 生成：openssl rand -base64 48
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_48

# ───── LLM（可选）─────
# 不填则关闭 AI 功能（接口会明确提示未启用，不影响其他功能）
LLM_ENABLED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.siliconflow.cn/v1
OPENAI_MODEL=deepseek-ai/DeepSeek-V3

# ───── HTTPS（使用 docker-compose.tls.yml 时必填）─────
# 已解析到本机公网 IP 的域名；Caddy 会自动申请 Let's Encrypt 证书
SITE_DOMAIN=
# 证书到期/异常通知邮箱
ACME_EMAIL=
# 启用 TLS 时把明文端口限制在回环，公网只走 443：
#   HTTP_PORT=127.0.0.1:8088

# ───── 站点地址（必填）----
# 部署完成后的对外地址，用于 OAuth 回调等
SITE_URL=http://localhost
OAUTH_REDIRECT_URL=http://localhost/oauth2/callback/github

# ───── CORS ─────
# 同域部署（默认 Nginx 托管前端）时留空即可。
# 仅当前后端独立域名时才填，例如：https://app.example.com
CORS_ALLOWED_ORIGINS=

# ───── 对象存储（用户上传的图片/视频）─────
# local=本地磁盘（默认，无需云凭据）；cos=腾讯云 COS
STORAGE_PROVIDER=cos
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=
# 可选：自定义/CDN 域名，留空则用 COS 默认域名
COS_PUBLIC_DOMAIN=
COS_UPLOAD_PREFIX=uploads
